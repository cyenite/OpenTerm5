{
  "name": "openterm5",
  "productName": "OpenTerm5",
  "version": "0.1.0",
  "description": "Open-source, cross-platform desktop trading terminal for MetaTrader 5 accounts, with copy trading, risk-based orders and a webhook signal API.",
  "keywords": [
    "trading",
    "metatrader",
    "mt5",
    "forex",
    "electron",
    "copy-trading",
    "desktop"
  ],
  "homepage": "https://github.com/cyenite/OpenTerm5#readme",
  "bugs": {
    "url": "https://github.com/cyenite/OpenTerm5/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyenite/OpenTerm5.git"
  },
  "author": "The OpenTerm5 contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on tcp:5199 && cross-env OPENTERM_DEV_URL=http://localhost:5199 electron .",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.electron.build.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsx --test src/lib/*.test.ts electron/*.test.ts shared/*.test.ts",
    "probe:mt5-web": "tsx scripts/mt5-web-probe.ts",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "check": "npm run typecheck && npm test && npm run build",
    "icons": "electron scripts/render-icons.cjs"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wait-on": "9.5.1"
  }
}
