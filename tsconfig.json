{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [],
    "paths": {
      "@meridian/charts": ["./packages/meridian-charts/src/index.ts"],
      "@meridian/charts/*": ["./packages/meridian-charts/src/*"]
    }
  },
  "include": ["src", "shared", "packages/meridian-charts/src"],
  "exclude": ["src/**/*.test.ts", "shared/**/*.test.ts", "packages/**/*.test.ts"]
}
